rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for product images — CDN optimized
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }
    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid));
    }
    // Private admin uploads
    match /admin/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Deny else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
