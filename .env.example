# HANA FREE SHOP — Environment Variables for 100k
# Copy to .env and fill with real values — NEVER commit .env to git

# Firebase Config (public, but use env for flexibility)
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=hana-free-shop.firebaseapp.com
FIREBASE_PROJECT_ID=hana-free-shop
FIREBASE_STORAGE_BUCKET=hana-free-shop.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef

# Stripe (secret — server only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SendGrid Email
SENDGRID_API_KEY=SG....

# Twilio SMS
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE=+383...

# Sentry for error monitoring
SENTRY_DSN=https://...@sentry.io/...

# Google Analytics & Facebook Pixel
GA4_ID=G-HANA100K
FB_PIXEL_ID=...

# Cloudflare CDN (optional)
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ZONE_ID=...

# Admin
ADMIN_EMAIL=owner@hanafreeshop.com
ADMIN_2FA_SECRET=...

# Environment
NODE_ENV=production
STAGING_URL=https://staging.hanafreeshop.com
PRODUCTION_URL=https://hanafreeshop.com

# Security — httpOnly cookies (set via Cloud Functions)
# COOKIE_SECRET should be 32+ random chars
COOKIE_SECRET=your_32_char_random_secret_here

# Quotas — Blaze plan
# Firestore: 100k reads/day, 20k writes/day, 20k deletes/day
# Storage: 5GB, 1GB/day download
# Hosting: 10GB/month transfer, 1GB storage
